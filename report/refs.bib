% Bibliography. One rule that is not a style preference:
%
% CITE A REPOSITORY AT A COMMIT, NEVER AT A BRANCH. A citation to `main` is a
% citation to whatever `main` says on the day it is read, which makes it
% unverifiable in exactly the way this project's whole record is arranged
% against. The @software entry below is the shape; delete it once you have a
% real one.

@software{example-repository,
  author  = {Author, An},
  title   = {A repository this report depends on},
  year    = {2026},
  url     = {https://github.com/org/name},
  note    = {Commit \texttt{0000000000000000000000000000000000000000}}
}
